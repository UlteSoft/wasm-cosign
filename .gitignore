# Binaries for programs and plugins
.DS_Store
.DS_STORE
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# cosign stuff
/cosign*
.vscode
.idea

# fuzzing artifacts
*.libfuzzer
*fuzz.a

bin*
dist/
cosignImagerefs
/bundle
signature
certificate
sigstore-conformance
conformance

**verify-experimental*

# Generated WSEA qualification artifacts and Python caches
/test/wsea/results/
/test/wsea/go_*_sources*.sha256
__pycache__/
*.py[cod]

# Source-owned OpenSSL includes upstream fixtures named signature and *.out.
!third_party/openssl/upstream/**
/.wsea-build/
/.tmp/

# Generated local qualification output never belongs in source releases.
/test/wsea/*results*/
/test/wsea/*report*.json
/test/wsea/*receipt*.json
/test/wsea/20*/
/test/wsea/*-20*/
/release-assets/
*.log
